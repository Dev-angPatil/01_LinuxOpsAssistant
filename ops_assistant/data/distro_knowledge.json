        {
          "id": "RPM_DB_CORRUPTED",
          "pattern": "cannot open Packages database in /var/lib/rpm",
          "remediation": "sudo rm -f /var/lib/rpm/__db* && sudo rpm --rebuilddb",
          "explanation": "The Berkeley DB RPM database is stale or corrupted."
        },
        {
          "id": "SELINUX_DENIAL",
          "pattern": "SELinux is preventing .* from (read|write|open|execute|connect)",
          "remediation": "sudo ausearch -m avc -ts recent | audit2why; sudo restorecon -Rv {path}",
          "explanation": "SELinux MAC security context denied access to the file or socket."
